# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash
#
# Deploy secrets with:
#   supabase secrets set OPENROUTER_API_KEY=... OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash
#
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY
# are provided automatically in the Edge runtime.
