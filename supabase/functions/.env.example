# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4
# ENCRYPTION_SECRET=your-long-random-secret
#
# Deploy secrets with:
#   supabase secrets set OPENROUTER_API_KEY=... OPENROUTER_DEFAULT_MODEL=... ENCRYPTION_SECRET=...
#
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY
# are provided automatically in the Edge runtime.
