          "rawOutput": "{\n  \"n\": {\n    \"1\": \"female voice, mid-range pitch, clear articulation\",\n    \"2\": \"male voice, low pitch, calm delivery\"\n  },\n  \"s\": [\n    [\n      1,\n      0.0,\n      5.2,\n      \"Good morning everyone. Thanks for joining the weekly planning meeting for the mobile app redesign.\"\n    ],\n    [\n      2,\n      5.9,\n      11.8,\n      \"Morning. I reviewed the design files yesterday and I have a few concerns about the onboarding flow.\"\n    ],\n    [\n      1,\n      12.4,\n      16.5,\n      \"Okay, let's start there. What is the main problem you noticed?\"\n    ],\n    [\n      2,\n      17.2,\n      23.8,\n      \"The sign-up screen asks for too much information upfront. Most people will abandon it before they finish.\"\n    ],\n    [\n      1,\n      24.4,\n      30.5,\n      \"That makes sense. Could we move the profile questions to a later step, after the first login?\"\n    ],\n    [\n      2,\n      31.1,\n      37.8,\n      \"Yes, I think that would work. We would only ask for an email address and a password at the beginning.\"\n    ],\n    [\n      1,\n      38.3,\n      38.7,\n      \"Great.\"\n    ]\n  ],\n  \"l\": \"en\"\n}\n{\n  \"n\": {\n    \"1\": \"female voice, clear and professional\",\n    \"2\": \"male voice, calm and cooperative\"\n  },\n  \"s\": [\n    [\n      1,\n      0.72,\n      4.56,\n      \"Then let's decide that the sign-up screen will only collect email and password.\"\n    ],\n    [\n      2,\n      5.2,\n      9.92,\n      \"Agreed. I will update the wireframes and share them with the team before Thursday.\"\n    ],\n    [\n      1,\n      10.64,\n      18.08,\n      \"Perfect. The next topic is the notification settings. Customers keep asking for a quiet mode during the weekend.\"\n    ],\n    [\n      2,\n      18.72,\n      22.8,\n      \"We could add a simple toggle in the settings page. It should be easy to build.\"\n    ],\n    [\n      1,\n      23.44,\n      27.6,\n      \"I like that idea, but we need to check with the backend team about scheduling.\"\n    ],\n    [\n      2,\n      28.32,\n      32.8,\n      \"I can talk to Omar about it this afternoon, and I will report back tomorrow.\"\n    ],\n    [\n      1,\n      33.44,\n      37.6,\n      \"Thank you. Another item is the performance of the dashboard.\"\n    ]\n  ],\n  \"l\": \"en\"\n}",
