# App URL used for auth redirects + deep links (no trailing slash)
# Dev:  http://localhost:5173
# Prod: https://app.hilm.tech  (MUST match Netlify VITE_APP_URL)
# Never leave production Site URL on localhost — verification emails use Supabase Site URL
# as a fallback when redirectTo is rejected.
VITE_APP_URL=http://localhost:5173

# Optional: audit/patch Supabase Auth URL + SMTP via Management API (never commit tokens)
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=your-project-ref

# Supabase (browser client) — Vite names (preferred)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push (public key only — never put the private key in Netlify/Vite)
# Generate: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Also accepted (Netlify / Next-style aliases):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_APP_URL=https://app.hilm.tech
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Direct Postgres (migrations / CLI) — never prefix with VITE_
# Note: db.*.supabase.co is IPv6-only. Netlify needs the IPv4 pooler URL below.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
# Transaction pooler (serverless / Netlify functions) — IPv4
# DATABASE_POOLER_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# OpenRouter (Edge Functions / server only)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash
# Comma-separated allowlist (rejects client-supplied expensive/unknown models)
# OPENROUTER_ALLOWED_MODELS=google/gemini-2.5-flash,google/gemini-2.5-pro,openai/gpt-4.1-mini,anthropic/claude-sonnet-4

# Soniox async STT — primary meeting transcription (Netlify functions only, never VITE_*).
# Without it meetings use the Gemini path. MEETING_STT_PRIMARY=gemini forces Gemini in an emergency.
SONIOX_API_KEY=

# Transactional email via Resend (Netlify functions only — never VITE_*). See docs/email.md.
# Without RESEND_API_KEY nothing is sent and queued emails are dropped, not delivered late.
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=
# Optional overrides (defaults shown); must be on the domain verified in Resend (hilm.tech):
# RESEND_FROM_NOTIFICATIONS=Hilm Notifications <notifications@hilm.tech>
# RESEND_FROM_SECURITY=Hilm Security <security@hilm.tech>
# RESEND_FROM_TEAM=Hilm Team <team@hilm.tech>
# RESEND_FROM_MARKETING=Hilm <noreply@hilm.tech>
# Product emails: signs one-click unsubscribe links (32+ random chars; marketing is refused without it)
# EMAIL_UNSUBSCRIBE_SECRET=
# Private admin console hostname (Netlify Builds + Functions scope); see docs/admin-portal.md
# ADMIN_HOST=
# Supabase Auth → Hooks → Send Email (HTTPS) secret, "v1,whsec_…"
# SUPABASE_AUTH_HOOK_SECRET=
# Link origin in emails (defaults to APP_URL, then https://app.hilm.tech):
# APP_BASE_URL=https://app.hilm.tech
# Local manual test only (npm run email:test -- --send):
# EMAIL_TEST_RECIPIENT=

# Reminder + email jobs (fail closed if missing)
# APP_URL=https://app.hilm.tech
CRON_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
