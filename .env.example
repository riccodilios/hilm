# App URL used for auth redirects + deep links (no trailing slash)
# Dev example: http://localhost:5173
# Prod example: https://hilm.yourdomain.com
VITE_APP_URL=http://localhost:5173

# Supabase (browser client)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Direct Postgres (migrations / CLI) — never prefix with VITE_
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# OpenRouter (Edge Functions / server only)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash

# Reminder emails (Edge Functions / server only)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Hilm <noreply@yourdomain.com>
# APP_URL=https://hilm.yourdomain.com
# CRON_SECRET=
