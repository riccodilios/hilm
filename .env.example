# App URL used for auth redirects + deep links (no trailing slash)
# Dev:  http://localhost:5173
# Prod: https://hillm.netlify.app  (MUST match Netlify VITE_APP_URL)
# Never leave production Site URL on localhost — verification emails use Supabase Site URL
# as a fallback when redirectTo is rejected.
VITE_APP_URL=http://localhost:5173

# Optional: audit/patch Supabase Auth URL + SMTP via Management API (never commit tokens)
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=your-project-ref

# Supabase (browser client) — Vite names (preferred)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push (public key only — never put the private key in Netlify/Vite)
# Generate: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Also accepted (Netlify / Next-style aliases):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_APP_URL=https://hillm.netlify.app
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Direct Postgres (migrations / CLI) — never prefix with VITE_
# Note: db.*.supabase.co is IPv6-only. Netlify needs the IPv4 pooler URL below.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres
# Transaction pooler (serverless / Netlify functions) — IPv4
# DATABASE_POOLER_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres

# OpenRouter (Edge Functions / server only)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash
# Comma-separated allowlist (rejects client-supplied expensive/unknown models)
# OPENROUTER_ALLOWED_MODELS=google/gemini-2.5-flash,google/gemini-2.5-pro,openai/gpt-4.1-mini,anthropic/claude-sonnet-4

# Reminder emails + push (Edge Function secrets — set via `supabase secrets set`)
# APP_URL=https://hillm.netlify.app
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Hilm <onboarding@resend.dev>
# Required for reminder jobs — fail closed if missing
CRON_SECRET=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
